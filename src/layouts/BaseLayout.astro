---
import '../styles/global.css';
import { __ } from '../lib/i18n';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'NK Studios Hub',
  description = 'Astro base with React for creating fast, interactive experiences.',
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR" data-i18n-ready="true" data-locale="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={__(description)}
      data-i18n-attr-content={description}
    />
    <link rel="icon" type="image/svg+xml" href="/NK_STUDIOS_ICON.svg" />
    <style>
      html[data-i18n-ready='false'] [data-page-shell] {
        visibility: hidden;
      }
    </style>
    <script is:inline>
      (() => {
        const normalizeLocale = (value) => {
          if (!value) return 'pt';

          const normalized = value.trim().toLowerCase();

          if (normalized === 'pr' || normalized.startsWith('pt')) return 'pt';
          if (normalized.startsWith('es')) return 'es';
          if (normalized.startsWith('en')) return 'en';

          return 'pt';
        };

        const localeToLang = {
          pt: 'pt-BR',
          en: 'en-US',
          es: 'es-ES',
        };

        let locale = 'pt';

        try {
          locale = normalizeLocale(window.localStorage.getItem('nkstudios-locale'));
          window.localStorage.setItem('nkstudios-locale', locale);
        } catch {
          locale = 'pt';
        }

        document.documentElement.dataset.locale = locale;
        document.documentElement.dataset.i18nReady = locale === 'pt' ? 'true' : 'false';
        document.documentElement.dataset.pageLoading = 'true';
        document.documentElement.lang = localeToLang[locale] ?? 'pt-BR';
      })();
    </script>
    <title>{title}</title>
  </head>
  <body class="bg-[var(--page-bg)] text-[var(--Branco)] antialiased">
    <div
      id="initial-loader"
      class="initial-loader"
      aria-live="polite"
      aria-busy="true"
    >
      <div class="initial-loader__content">
        <img
          src="/images/NK_STUDIOS_icone.png"
          alt="NK Studios"
          class="initial-loader__icon"
          data-loading-ignore
        />
        <p class="initial-loader__progress" aria-label="Loading progress">
          <span data-loading-value>0</span><span>%</span>
        </p>
      </div>
    </div>

    <div data-page-shell class="page-shell">
      <Header />
      <slot />
    </div>

    <script>
      import {
        ensureLocale,
        getStoredLocale,
        LOCALE_STORAGE_KEY,
        subscribeLocaleChange,
        translateDocument,
      } from '../lib/i18n';

      translateDocument(ensureLocale());

      subscribeLocaleChange((locale) => {
        translateDocument(locale);
      });

      window.addEventListener('storage', (event) => {
        if (event.key !== LOCALE_STORAGE_KEY) return;

        translateDocument(getStoredLocale());
      });

      window.addEventListener('focus', () => {
        translateDocument(getStoredLocale());
      });
    </script>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const loader = document.getElementById('initial-loader');
        const progressValue = loader?.querySelector('[data-loading-value]');
        const viewport = document.querySelector('[data-skills-viewport-host]');

        if (!(loader instanceof HTMLElement) || !(progressValue instanceof HTMLElement)) {
          root.dataset.pageLoading = 'false';
          return;
        }

        const taskState = new Map();
        let completedTasks = 0;
        let targetProgress = 0;
        let displayedProgress = 0;
        let readyToReveal = false;
        let loaderDismissed = false;
        let animationFrameId = 0;
        const minimumLoaderTime = 450;
        const startedAt = window.performance.now();

        const updateTargetProgress = () => {
          const totalTasks = Math.max(taskState.size, 1);
          targetProgress = Math.round((completedTasks / totalTasks) * 100);
          loader.style.setProperty('--loading-progress', `${targetProgress}%`);
        };

        const registerTask = (id) => {
          if (taskState.has(id)) return;

          taskState.set(id, false);
          updateTargetProgress();
        };

        const completeTask = (id) => {
          if (!taskState.has(id) || taskState.get(id) === true) return;

          taskState.set(id, true);
          completedTasks += 1;
          updateTargetProgress();

          if (completedTasks === taskState.size) {
            readyToReveal = true;
          }
        };

        const dismissLoader = () => {
          if (loaderDismissed) return;

          loaderDismissed = true;
          displayedProgress = 100;
          progressValue.textContent = '100';
          loader.dataset.complete = 'true';
          loader.setAttribute('aria-busy', 'false');
          root.dataset.pageLoading = 'false';

          window.setTimeout(() => {
            loader.remove();
          }, 700);
        };

        const animateProgress = () => {
          const difference = targetProgress - displayedProgress;

          if (Math.abs(difference) < 0.35) {
            displayedProgress = targetProgress;
          } else {
            displayedProgress += difference * 0.16;
          }

          progressValue.textContent = String(Math.round(displayedProgress));

          const minimumTimeReached = window.performance.now() - startedAt >= minimumLoaderTime;

          if (readyToReveal && displayedProgress >= 99.6 && minimumTimeReached) {
            dismissLoader();
            return;
          }

          animationFrameId = window.requestAnimationFrame(animateProgress);
        };

        registerTask('window-load');
        if (document.readyState === 'complete') {
          completeTask('window-load');
        } else {
          window.addEventListener('load', () => completeTask('window-load'), { once: true });
        }

        registerTask('fonts-ready');
        if ('fonts' in document && document.fonts?.ready) {
          document.fonts.ready
            .catch(() => undefined)
            .finally(() => completeTask('fonts-ready'));
        } else {
          completeTask('fonts-ready');
        }

        const images = Array.from(document.images).filter(
          (image) => !image.hasAttribute('data-loading-ignore'),
        );

        for (const [index, image] of images.entries()) {
          const taskId = `image-${index}`;
          registerTask(taskId);

          const markImageReady = () => completeTask(taskId);

          if (image.complete) {
            if (typeof image.decode === 'function') {
              image.decode().catch(() => undefined).finally(markImageReady);
            } else {
              markImageReady();
            }

            continue;
          }

          image.addEventListener('load', markImageReady, { once: true });
          image.addEventListener('error', markImageReady, { once: true });
        }

        registerTask('viewport-ready');
        if (viewport) {
          const viewportTimeoutId = window.setTimeout(() => {
            completeTask('viewport-ready');
          }, 3200);

          window.addEventListener(
            'nkstudios:viewport-ready',
            () => {
              window.clearTimeout(viewportTimeoutId);
              completeTask('viewport-ready');
            },
            { once: true },
          );
        } else {
          completeTask('viewport-ready');
        }

        window.addEventListener('pagehide', () => {
          window.cancelAnimationFrame(animationFrameId);
        });

        updateTargetProgress();
        animationFrameId = window.requestAnimationFrame(animateProgress);
      })();
    </script>
  </body>
</html>
