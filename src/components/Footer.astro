---
import { __ } from '../lib/i18n';

const navigation = [
  { href: '#sobre', label: 'About' },
  { href: '#skills', label: 'Skills' },
  { href: '#projetos', label: 'Projects' },
  { href: '#contato', label: 'Contact' },
];
---

<footer class="site-footer" aria-label="Footer">
  <div class="site-footer__artwork">
    <img
      class="site-footer__dragon"
      src="/images/dragon.png"
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
    />
    <img
      class="site-footer__fire"
      src="/images/fire.png"
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
    />

    <nav class="site-footer__navigation" aria-label="Footer navigation">
      {navigation.map(({ href, label }) => (
        <a href={href} data-i18n-key={label}>{__(label)}</a>
      ))}
    </nav>

    <details class="site-footer__mobile-menu" data-footer-mobile-menu>
      <summary aria-label={__('Open menu')} data-i18n-attr-aria-label="Open menu">
        <span class="sr-only" data-i18n-key="Open menu">{__('Open menu')}</span>
        <span class="site-footer__menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </summary>

      <nav aria-label="Footer navigation">
        {navigation.map(({ href, label }) => (
          <a href={href} data-i18n-key={label}>{__(label)}</a>
        ))}
      </nav>
    </details>

    <img
      class="site-footer__wordmark"
      src="/images/NK_STUDIOS.png"
      alt="NK Studios"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="site-footer__socials" aria-label="Social media">
    <a
      href="https://www.instagram.com/guedes_nk/"
      target="_blank"
      rel="noreferrer"
      aria-label="Instagram"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
        <circle cx="12" cy="12" r="4.25"></circle>
        <circle class="site-footer__icon-dot" cx="17.4" cy="6.7" r="1"></circle>
      </svg>
    </a>
    <a
      href="https://github.com/NikolasGuedes"
      target="_blank"
      rel="noreferrer"
      aria-label="GitHub"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 2.25a9.75 9.75 0 0 0-3.08 19c.49.09.67-.21.67-.47v-1.7c-2.73.59-3.31-1.16-3.31-1.16-.45-1.14-1.09-1.44-1.09-1.44-.89-.61.07-.6.07-.6.98.07 1.5 1.01 1.5 1.01.88 1.5 2.3 1.07 2.86.82.09-.63.34-1.07.62-1.32-2.18-.25-4.47-1.09-4.47-4.82 0-1.07.38-1.94 1.01-2.62-.1-.25-.44-1.24.1-2.58 0 0 .82-.26 2.68 1a9.3 9.3 0 0 1 4.88 0c1.86-1.26 2.68-1 2.68-1 .54 1.34.2 2.33.1 2.58.63.68 1.01 1.55 1.01 2.62 0 3.74-2.3 4.57-4.48 4.82.35.3.66.9.66 1.82v2.7c0 .26.18.57.67.47A9.75 9.75 0 0 0 12 2.25Z"></path>
      </svg>
    </a>
    <a
      href="https://www.linkedin.com/in/nikolas-guedes-da-silva-6497541a1/"
      target="_blank"
      rel="noreferrer"
      aria-label="LinkedIn"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5.36 7.75A2.13 2.13 0 1 0 5.36 3.5a2.13 2.13 0 0 0 0 4.25ZM3.5 20.5h3.72V9.46H3.5V20.5ZM9.43 9.46h3.56v1.51h.05c.5-.94 1.71-1.94 3.51-1.94 3.76 0 4.45 2.47 4.45 5.69v5.78h-3.71v-5.12c0-1.22-.02-2.79-1.7-2.79-1.7 0-1.96 1.33-1.96 2.7v5.21H9.92l-.49-11.04Z"></path>
      </svg>
    </a>
  </div>
</footer>

<script>
  const footerMobileMenu = document.querySelector<HTMLDetailsElement>('[data-footer-mobile-menu]');

  footerMobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      footerMobileMenu.open = false;
    });
  });

  document.addEventListener('click', (event) => {
    if (!footerMobileMenu?.open || !(event.target instanceof Node)) return;
    if (!footerMobileMenu.contains(event.target)) footerMobileMenu.open = false;
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && footerMobileMenu?.open) footerMobileMenu.open = false;
  });
</script>

<style>
  .site-footer {
    --social-height: clamp(5rem, 7.4vw, 8rem);
    position: relative;
    isolation: isolate;
    width: 100%;
    height: min(64.82vw, 72.6rem);
    overflow: hidden;
    background: #fff;
    color: #000;
  }

  .site-footer__artwork {
    position: absolute;
    inset-block: 0;
    left: 0;
    isolation: isolate;
    width: 100%;
  }

  .site-footer__dragon,
  .site-footer__fire {
    --footer-art-x: 0%;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    transform-origin: center;
    user-select: none;
    will-change: transform;
  }

  .site-footer__dragon {
    z-index: -2;
    animation: footer-dragon-drift 3s ease-in-out infinite alternate;
  }

  .site-footer__fire {
    z-index: -3;
    animation: footer-fire-drift 5s ease-in-out infinite alternate;
  }

  .site-footer__navigation {
    position: absolute;
    z-index: 1;
    top: 45.4%;
    left: max(clamp(1rem, 1.15vw, 1.25rem), calc((100% - 112rem) / 2 + 1.25rem));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(0.8rem, 1.4vw, 1.4rem);
    padding: clamp(0.55rem, 0.8vw, 0.85rem) clamp(0.6rem, 0.9vw, 0.95rem);
    background: #fff;
  }

  .site-footer__navigation a {
    font-size: clamp(1.75rem, 2.72vw, 2.95rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: 0.025em;
    text-transform: uppercase;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .site-footer__navigation a:hover {
    opacity: 0.58;
    transform: translateX(0.35rem);
  }

  .site-footer__navigation a:focus-visible,
  .site-footer__mobile-menu summary:focus-visible,
  .site-footer__mobile-menu a:focus-visible,
  .site-footer__socials a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 0.35rem;
  }

  .site-footer__mobile-menu {
    display: none;
  }

  .site-footer__wordmark {
    position: absolute;
    z-index: 1;
    right: auto;
    bottom: calc(var(--social-height) - clamp(0.55rem, 0.95vw, 1rem));
    left: 50%;
    width: min(calc(100% - clamp(2rem, 2.35vw, 2.55rem)), 109.5rem);
    height: auto;
    filter: brightness(0);
    transform: translateX(-50%);
    pointer-events: none;
    user-select: none;
  }

  .site-footer__socials {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    height: var(--social-height);
    align-items: center;
    justify-content: center;
    gap: clamp(3rem, 6.7vw, 7.25rem);
    background: #000;
    color: var(--Branco);
  }

  .site-footer__socials a {
    display: grid;
    width: clamp(2rem, 2.75vw, 3rem);
    height: clamp(2rem, 2.75vw, 3rem);
    place-items: center;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .site-footer__socials a:hover {
    opacity: 0.72;
    transform: translateY(-0.2rem);
  }

  .site-footer__socials svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: currentColor;
  }

  .site-footer__socials a:first-child svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.15;
  }

  .site-footer__socials .site-footer__icon-dot {
    fill: currentColor;
    stroke: none;
  }

  @media (max-width: 48rem) {
    .site-footer {
      height: clamp(39rem, 160vw, 48rem);
    }

    .site-footer__artwork {
      width: 100%;
    }

    .site-footer__dragon,
    .site-footer__fire {
      --footer-art-x: -29%;
      width: 154%;
      max-width: none;
      object-position: 70% center;
    }

    .site-footer__navigation {
      display: none;
    }

    .site-footer__mobile-menu {
      position: absolute;
      z-index: 3;
      top: 48%;
      left: 1rem;
      display: block;
      color: #000;
    }

    .site-footer__mobile-menu summary {
      display: grid;
      width: 3.25rem;
      height: 3.25rem;
      cursor: pointer;
      list-style: none;
      place-items: center;
      border: 1px solid rgba(0, 0, 0, 0.2);
      border-radius: 999px;
      background: #fff;
      box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.12);
    }

    .site-footer__mobile-menu summary::-webkit-details-marker {
      display: none;
    }

    .site-footer__menu-icon {
      display: flex;
      width: 1.15rem;
      flex-direction: column;
      gap: 0.24rem;
    }

    .site-footer__menu-icon span {
      display: block;
      width: 100%;
      height: 1px;
      background: currentColor;
      transition: transform 180ms ease, opacity 180ms ease;
    }

    .site-footer__mobile-menu[open] .site-footer__menu-icon span:first-child {
      transform: translateY(0.3rem) rotate(45deg);
    }

    .site-footer__mobile-menu[open] .site-footer__menu-icon span:nth-child(2) {
      opacity: 0;
    }

    .site-footer__mobile-menu[open] .site-footer__menu-icon span:last-child {
      transform: translateY(-0.3rem) rotate(-45deg);
    }

    .site-footer__mobile-menu nav {
      position: absolute;
      top: calc(100% + 0.55rem);
      left: 0;
      display: flex;
      width: max-content;
      min-width: 10.5rem;
      flex-direction: column;
      gap: 0.15rem;
      padding: 0.55rem;
      background: #fff;
      box-shadow: 0 0.75rem 2rem rgba(0, 0, 0, 0.16);
    }

    .site-footer__mobile-menu nav a {
      padding: 0.5rem 0.65rem;
      font-size: 1.15rem;
      font-weight: 300;
      line-height: 1;
      letter-spacing: 0.025em;
      text-transform: uppercase;
    }

    .site-footer__wordmark {
      right: 0.75rem;
      bottom: calc(var(--social-height) - 0.35rem);
      left: 0.75rem;
      width: calc(100% - 1.5rem);
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__dragon,
    .site-footer__fire {
      animation: none;
      transform: translateX(var(--footer-art-x));
      will-change: auto;
    }

    .site-footer__navigation a,
    .site-footer__mobile-menu span,
    .site-footer__socials a {
      transition: none;
    }
  }

  @keyframes footer-dragon-drift {
    0% {
      transform: translateX(var(--footer-art-x)) translate3d(-0.45%, -0.25%, 0) scale(1.018) rotate(-0.08deg);
    }

    50% {
      transform: translateX(var(--footer-art-x)) translate3d(0.2%, 0.35%, 0) scale(1.024) rotate(0.04deg);
    }

    100% {
      transform: translateX(var(--footer-art-x)) translate3d(0.5%, -0.1%, 0) scale(1.02) rotate(0.09deg);
    }
  }

  @keyframes footer-fire-drift {
    0% {
      transform: translateX(var(--footer-art-x)) translate3d(0.35%, 0.25%, 0) scale(1.022) rotate(0.07deg);
    }

    50% {
      transform: translateX(var(--footer-art-x)) translate3d(-0.25%, -0.3%, 0) scale(1.016) rotate(-0.05deg);
    }

    100% {
      transform: translateX(var(--footer-art-x)) translate3d(-0.5%, 0.15%, 0) scale(1.025) rotate(-0.1deg);
    }
  }
</style>
