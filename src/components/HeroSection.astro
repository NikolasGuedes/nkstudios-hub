---
import SkillsViewport from './SkillsViewport';
import { __ } from '../lib/i18n';
---

<section id="top" class="relative isolate h-dvh overflow-hidden bg-[var(--page-bg)] text-[var(--text-primary)]">
  <div class="h-dvh overflow-hidden px-3 pb-3 pt-[calc(var(--header-height)+0.65rem)] sm:px-4 sm:pb-4 lg:px-6 lg:pb-5">
    <div class="mx-auto flex h-[calc(100dvh-var(--header-height)-0.65rem)] w-full max-w-[112rem] flex-col overflow-hidden">
      <div class="h-[min(70dvh,41rem)] shrink-0 md:h-[min(67dvh,46rem)] lg:h-[min(57dvh,40rem)]">
        <div data-skills-viewport-host class="h-full">
          <SkillsViewport client:only="react" />
        </div>
      </div>

      <div class="mt-1 flex min-h-0 flex-1 flex-col md:mt-2 lg:mt-3">
        <div class="flex items-end justify-between gap-4 pb-2 text-[var(--text-primary)] md:gap-6 mt-5 sm:mt-0">
          <div class="text-[clamp(0.68rem,0.9vw,1rem)] uppercase leading-[1.35] tracking-[0.02em] sm:tracking-[0.4em] text-[var(--text-primary)] md:text-[clamp(0.78rem,0.95vw,1rem)] md:leading-[1.45]">
            <p data-i18n-key="Sao Paulo, Brazil">{__('Sao Paulo, Brazil')}</p>
            <p class="flex items-center gap-1.5">
              <span data-i18n-key="Open to work">{__('Open to work')}</span>
              <span
                aria-hidden="true"
                class="inline-block h-[0.8em] w-[0.8em] rounded-full bg-current"
              />
            </p>
          </div>

          <div class="text-right text-[clamp(0.68rem,0.9vw,1rem)] uppercase leading-[1.35] tracking-[0.02em] text-[var(--text-primary)] md:text-[clamp(0.78rem,0.95vw,1rem)] sm:tracking-[0.4em]">
            <p>Nikolas Guedes da Silva</p>
            <p data-i18n-key="28 years old">{__('28 years old')}</p>
          </div>
        </div>

        <div class="flex min-h-0 flex-1 items-start overflow-hidden pt-1 md:pt-2 lg:items-end lg:pt-0 lg:pb-5">
          <img
            src="/images/NK_STUDIOS.png"
            alt="NK Studios"
            class="block h-auto w-full object-contain object-left-top lg:max-h-full lg:object-left-bottom"
          />
        </div>
      </div>
    </div>
  </div>
</section>
