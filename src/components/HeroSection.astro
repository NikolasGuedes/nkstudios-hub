---
import SkillsViewport from './SkillsViewport';
---

<section class="relative isolate h-screen overflow-hidden bg-black text-white">
  <div class="flex h-full flex-col px-3 pt-4 sm:px-4 lg:px-6">
    <div class="mx-auto flex h-full w-full max-w-[112rem] flex-col">
      <div class="h-[min(64vh,46rem)] shrink-0">
        <SkillsViewport client:only="react" />
      </div>

      <div class="mt-2 flex min-h-0 flex-1 flex-col justify-end pb-4 sm:pb-5 lg:pb-6">
        <div class="flex items-end justify-between gap-6 pb-4 text-white">
          <div class="text-[clamp(0.78rem,0.95vw,1rem)] uppercase leading-[1.45] tracking-[-0.03em] text-white/82">
            <p>Brasil, Sao Paulo</p>
            <p>Open to work &#9679;</p>
          </div>

          <div class="text-right text-[clamp(0.78rem,0.95vw,1rem)] uppercase leading-[1.45] tracking-[-0.03em] text-white/82">
            <p>Maio 31, 2026</p>
            <p>Nikolas Guedes da Silva, 28 anos</p>
          </div>
        </div>

        <img
          src="/images/NK_STUDIOS.png"
          alt="NK Studios"
          class="block h-auto w-full"
        />
      </div>
    </div>
  </div>
</section>
