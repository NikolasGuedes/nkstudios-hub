---
import SkillsViewport from './SkillsViewport';
---

<section class="relative isolate h-screen overflow-hidden bg-[var(--page-bg)] text-[var(--text-primary)]">
  <div class="flex h-full flex-col px-3 pt-4 sm:px-4 lg:px-6">
    <div class="mx-auto flex h-full w-full max-w-[112rem] flex-col">
      <div class="h-[min(64vh,46rem)] shrink-0">
        <SkillsViewport client:only="react" />
      </div>

      <div class="mt-2 flex min-h-0 flex-1 flex-col justify-end pb-4 sm:pb-5 lg:pb-6">
        <div class="flex items-end justify-between gap-6 pb-4 text-[var(--text-primary)]">
          <div class="text-[clamp(0.78rem,0.95vw,1rem)] uppercase leading-[1.45] tracking-[-0.03em] text-[var(--text-primary)]">
            <p>Brasil, São Paulo</p>
            <p class="flex items-center gap-1.5">
              <span>Open to work</span>
              <span
                aria-hidden="true"
                class="inline-block h-[0.8em] w-[0.8em] rounded-full bg-current"
              />
            </p>
          </div>

          <div class="text-right text-[clamp(0.78rem,0.95vw,1rem)] uppercase leading-[1.45] tracking-[-0.03em] text-[var(--text-primary)]">
            <p>Nikolas Guedes da Silva</p>
            <p>28 anos de idade</p>
          </div>
        </div>

        <img
          src="/images/NK_STUDIOS.png"
          alt="NK Studios"
          class="block h-auto w-full"
        />
      </div>
    </div>
  </div>
</section>

<script>
  const currentDateElement = document.querySelector('#current-date');

  if (currentDateElement) {
    currentDateElement.textContent = new Intl.DateTimeFormat('pt-BR', {
      day: '2-digit',
      month: 'long',
      year: 'numeric',
      timeZone: 'America/Sao_Paulo',
    }).format(new Date());
  }
</script>
