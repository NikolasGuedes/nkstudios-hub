---
import { __ } from '../lib/i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
---

<header class="fixed inset-x-0 top-0 z-50  bg-black/82 backdrop-blur-xl">
  <div class="mx-auto flex h-[var(--header-height)] w-full max-w-[112rem] items-center justify-between px-3 sm:px-4 lg:px-0">
    <a
      href="#top"
      aria-label="NK Studios"
      class="flex shrink-0 items-center"
    >
      <img
        src="/images/NK_STUDIOS_icone.png"
        alt="NK Studios"
        class="h-8 w-auto object-contain sm:h-9"
      />
    </a>

    <div class="flex items-center gap-2 sm:gap-4 lg:gap-5">
      <nav class="hidden items-center gap-2 md:flex md:gap-3">
        <a
          href="#sobre"
          data-i18n-key="About"
          class="rounded-full px-3 py-2 text-[0.72rem] font-medium uppercase tracking-[0.16em] text-[var(--Branco)] transition hover:bg-[var(--surface-softer)]"
        >
          {__('About')}
        </a>
        <a
          href="#skills"
          data-i18n-key="Skills"
          class="rounded-full px-3 py-2 text-[0.72rem] font-medium uppercase tracking-[0.16em] text-[var(--Branco)] transition hover:bg-[var(--surface-softer)]"
        >
          {__('Skills')}
        </a>
        <a
          href="#projetos"
          data-i18n-key="Projects"
          class="rounded-full px-3 py-2 text-[0.72rem] font-medium uppercase tracking-[0.16em] text-[var(--Branco)] transition hover:bg-[var(--surface-softer)]"
        >
          {__('Projects')}
        </a>
        <a
          href="#contato"
          data-i18n-key="Get in touch"
          class="rounded-full border border-[var(--Branco)] bg-[var(--Branco)] px-4 py-2 text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-[color:var(--page-bg)] transition hover:opacity-90"
          style="color: var(--page-bg);"
        >
          {__('Get in touch')}
        </a>
      </nav>

      <details data-mobile-nav class="group relative md:hidden">
        <summary
          class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-[var(--line-mid)] bg-[var(--surface-softer)] text-[var(--Branco)] transition hover:bg-[var(--surface-soft)]"
          aria-label={__('Open menu')}
          data-i18n-attr-aria-label="Open menu"
        >
          <span class="sr-only" data-i18n-key="Open menu">{__('Open menu')}</span>
          <span class="flex flex-col gap-[0.22rem]">
            <span class="block h-px w-4 bg-current"></span>
            <span class="block h-px w-4 bg-current"></span>
            <span class="block h-px w-4 bg-current"></span>
          </span>
        </summary>

        <div class="absolute right-0 mt-3 flex w-[15rem] flex-col gap-2 rounded-3xl border border-[var(--line-mid)] bg-black/92 p-3 shadow-[var(--shadow-panel-lg)] backdrop-blur-xl">
          <a
            href="#sobre"
            data-i18n-key="About"
            class="rounded-2xl px-4 py-3 text-[0.78rem] font-medium uppercase tracking-[0.16em] text-[var(--Branco)] transition hover:bg-[var(--surface-softer)]"
          >
            {__('About')}
          </a>
          <a
            href="#skills"
            data-i18n-key="Skills"
            class="rounded-2xl px-4 py-3 text-[0.78rem] font-medium uppercase tracking-[0.16em] text-[var(--Branco)] transition hover:bg-[var(--surface-softer)]"
          >
            {__('Skills')}
          </a>
          <a
            href="#projetos"
            data-i18n-key="Projects"
            class="rounded-2xl px-4 py-3 text-[0.78rem] font-medium uppercase tracking-[0.16em] text-[var(--Branco)] transition hover:bg-[var(--surface-softer)]"
          >
            {__('Projects')}
          </a>
          <a
            href="#contato"
            data-i18n-key="Get in touch"
            class="rounded-full border border-[var(--Branco)] bg-[var(--Branco)] px-4 py-3 text-center text-[0.78rem] font-semibold uppercase tracking-[0.14em] transition hover:opacity-90"
            style="color: var(--page-bg);"
          >
            {__('Get in touch')}
          </a>
        </div>
      </details>

      <LanguageSwitcher />
    </div>
  </div>
</header>

<script>
  const bindDetailsDismiss = (selector) => {
    const element = document.querySelector(selector);

    if (!(element instanceof HTMLDetailsElement)) return;

    const closeOnOutsideClick = (event) => {
      const target = event.target;

      if (!(target instanceof Node)) return;
      if (element.contains(target)) return;

      element.open = false;
    };

    const closeOnEscape = (event) => {
      if (event.key !== 'Escape') return;
      element.open = false;
    };

    document.addEventListener('click', closeOnOutsideClick);
    document.addEventListener('keydown', closeOnEscape);
  };

  bindDetailsDismiss('[data-mobile-nav]');
</script>
